{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arachnid Client",
  "version": "0.14.0",
  "identifier": "com.arachnid.client",
  "build": {},
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Arachnid Client",
        "width": 1280,
        "height": 720,
        "minWidth": 300,
        "minHeight": 300,
        "resizable": true,
        "center": true,
        "backgroundColor": "#191919",
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "shortDescription": "Настольный клиент Stoat",
    "longDescription": "Официальный веб-клиент Stoat в окне Tauri: своя рамка окна, трей, автозапуск и Discord RPC."
  }
}
