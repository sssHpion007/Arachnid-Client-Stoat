{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri-Stoat",
  "version": "0.1.0",
  "identifier": "com.tauristoat.client",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Tauri-Stoat",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://cdn.stoatusercontent.com https://*.stoat.chat data:; connect-src ipc: http://ipc.localhost https://api.stoat.chat wss://events.stoat.chat https://cdn.stoatusercontent.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "shortDescription": "Клиент Stoat на Rust",
    "longDescription": "Клиент Stoat с ядром на Rust и плагинами в песочнице WASM."
  }
}
